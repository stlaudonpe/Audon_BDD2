    {
      "name": "71a3159a",
      "displayName": "pedidos_confirmados_detalle",
      "queryLines": [
        "SELECT\r\n",
        "    CAST(ordered_at AS DATE) AS fecha,\r\n",
        "    customer_id,\r\n",
        "    total_pedido,\r\n",
        "    unidades\r\n",
        "FROM workspace.default.silver_pedidos\r\n",
        "WHERE estado_ultimo_pago = 'APPROVED'\r\n",
        "  AND estado_pedido <> 'CANCELLED'"
      ]
    }
